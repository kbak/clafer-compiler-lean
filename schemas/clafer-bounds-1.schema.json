{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clafer explicit M1 bounds v1",
  "type": "object",
  "required": [
    "version",
    "objects",
    "bitwidth",
    "declarations"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "clafer-bounds/1"
    },
    "objects": {
      "type": "integer",
      "minimum": 0
    },
    "bitwidth": {
      "type": "integer",
      "minimum": 0
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "size",
          "exact"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "exact": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
