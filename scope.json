{
  "schema_version": 1,
  "name": "clafer-compiler-lean",
  "inputs": [
    "."
  ],
  "specification_paths": [
    "docs",
    "README.md",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "CLAUDE.md",
    "SECURITY.md"
  ],
  "test_paths": [
    "scripts/check.sh",
    "scripts/check.py"
  ],
  "review_paths": [
    "."
  ],
  "required_coverage": {
    "intent": [
      "req"
    ],
    "req": [
      "impl"
    ]
  },
  "policy": {
    "require_revision_increase": false,
    "allow_skipped_tests": false
  },
  "tests": {
    "format": "command",
    "command": [
      "bash",
      "scripts/check.sh"
    ],
    "timeout_seconds": 600
  }
}
