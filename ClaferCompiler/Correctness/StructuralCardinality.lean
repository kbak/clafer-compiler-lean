module

public import ClaferCompiler.Correctness.StructuralRelations
public import DPGraph.Predicates.Finite

@[expose] public section

namespace ClaferCompiler.Correctness.Structural
open Backend.Alloy Backend.Alloy.Structural SemanticsBridge.Structural

theorem interval_term (b : IR.Structural.Bounds) (r : Rel) : (interval b r).Term := by
  apply Formula.Term.conj
  · split <;> constructor
  · cases b.upper <;> constructor

theorem bounded_comparison (w : Nat) (a b : Int) :
    ((boundedInt w a).bind fun x => (boundedInt w b).bind fun y => some (Comparison.le.holds x y)) = some true ↔
      fitsInt w a = true ∧ fitsInt w b = true ∧ a ≤ b := by
  unfold boundedInt
  split <;> split <;> simp_all [Comparison.holds]

/-- Only numeric observations actually generated by the interval need a signed
representation. These are value/range conditions, independent of satisfaction. -/
def IntervalFits (w : Nat) (b : IR.Structural.Bounds) (k : Nat) : Prop :=
  (b.lower = 0 ∨ (fitsInt w b.lower = true ∧ fitsInt w k = true)) ∧
  match b.upper with
  | .unbounded => True
  | .finite hi => fitsInt w k = true ∧ fitsInt w hi = true

theorem interval_eval_iff (w : Nat) (b : IR.Structural.Bounds) (r : Rel)
    (i : Instance) (env : List Nat) :
    (interval b r).eval w i env = some true ↔
      IntervalFits w b (r.eval i env).eraseDups.length ∧
      DPGraph.Predicates.CountInRange (bounds b) (r.eval i env).eraseDups.length := by
  have hl : Formula.Term (if b.lower == 0 then Formula.truth else
      .compare .le (.literal (Int.ofNat b.lower)) (.count r)) := by split <;> constructor
  have hu : Formula.Term (match b.upper with
      | .unbounded => Formula.truth
      | .finite k => .compare .le (.count r) (.literal (Int.ofNat k))) := by
    cases b.upper <;> constructor
  refine (Formula.eval_conj_true hl hu w i env).trans ?_
  have hc (a b : Integer) : (Formula.compare .le a b).eval w i env =
      (do let x ← a.eval w i env; let y ← b.eval w i env; pure (Comparison.le.holds x y)) := rfl
  have ht : Formula.truth.eval w i env = some true := rfl
  have hLiteral (z : Int) : (Integer.literal z).eval w i env = boundedInt w z := rfl
  have hCount : (Integer.count r).eval w i env =
      boundedInt w (r.eval i env).eraseDups.length := rfl
  cases b with
  | mk lower upper =>
    cases upper <;> by_cases hz : lower = 0 <;>
      simp [hz, hc, ht, hLiteral, hCount, bounded_comparison, IntervalFits,
        DPGraph.Predicates.CountInRange, bounds] <;> tauto

theorem represented_parents {U : Type} [Fintype U] (v : IR.Structural.Layout n)
    (s : Clafer.Semantics.Configuration (Fin n) U) (i : Instance)
    (r : Represents v s i) (scopes : List Scope) (w : Nat)
    (h : Satisfies (target v scopes w) i) : s.Parents (interpret v.core) := by
  classical
  intro d c hc x hx
  have hf := Module.fact_true _ _ h.2.2.2.2.2 _
    (List.mem_map.mpr ⟨_, ownership_generated v d c hc, rfl⟩)
  have hu := (Formula.eval_all_true (.mult _ _) w i [] (head v d)).mp hf
    [(r.objects x).val] (by simpa [head] using (r.heads d x).mp hx)
  change some (((Rel.join (.var 0) (.transpose (contains v.core d))).eval i
    [(r.objects x).val]).eraseDups.length == 1) = some true at hu
  exact (unary_one (fun p => s.contains d p x) (fun p => (r.objects p).val)
    (Subtype.val_injective.comp r.objects.injective) _
    (represented_parent_fiber v s i r d c hc x)).mp (beq_iff_eq.mp (Option.some.inj hu))

theorem represented_multiplicities {U : Type} [Fintype U] (v : IR.Structural.Layout n)
    (s : Clafer.Semantics.Configuration (Fin n) U) (i : Instance)
    (r : Represents v s i) (scopes : List Scope) (w : Nat)
    (h : Satisfies (target v scopes w) i) : s.Multiplicities (interpret v.core) := by
  classical
  intro d c hc p hp
  have hf := Module.fact_true _ _ h.2.2.2.2.2 _
    (List.mem_map.mpr ⟨_, local_bounds_generated v d c hc, rfl⟩)
  have hu := (Formula.eval_all_true (interval_term _ _) w i [] (head v c)).mp hf
    [(r.objects p).val] (by simpa [head] using (r.heads c p).mp hp)
  have hn := (interval_eval_iff w _ _ i [(r.objects p).val]).mp hu |>.2
  rw [unary_card (fun x => s.contains d p x) (fun x => (r.objects x).val)
    (Subtype.val_injective.comp r.objects.injective) _
    (represented_contains_fiber v s i r d c hc p _ 0 rfl)] at hn
  exact (DPGraph.Predicates.inRange_card _ _).mpr hn

theorem represented_children {U : Type} (v : IR.Structural.Layout n)
    (s : Clafer.Semantics.Configuration (Fin n) U) (i : Instance)
    (r : Represents v s i) (d : Fin n) (p : U) (t : Tuple) :
    t ∈ (childHeads v.core d).eval i [(r.objects p).val] ↔
      ∃ x, s.Child (interpret v.core) d p x ∧ t = [(r.objects x).val] := by
  unfold childHeads
  rw [mem_union_eval _ (by
    intro q hq
    obtain ⟨c, _, rfl⟩ := List.mem_map.mp hq
    exact .join (.var _) (.field _))]
  simp only [List.mem_map]
  constructor
  · rintro ⟨q, ⟨c, hc, rfl⟩, hx⟩
    have hc := (child_inventory v.core d c).mp hc
    obtain ⟨x, hx, ht⟩ := (represented_contains_fiber v s i r c d hc p _ 0 rfl t).mp hx
    exact ⟨x, ⟨c, hc, hx⟩, ht⟩
  · rintro ⟨x, ⟨c, hc, hx⟩, rfl⟩
    exact ⟨_, ⟨c, (child_inventory v.core d c).mpr hc, rfl⟩,
      (represented_contains_fiber v s i r c d hc p _ 0 rfl _).mpr ⟨x, hx, rfl⟩⟩

theorem represented_groups {U : Type} [Fintype U] (v : IR.Structural.Layout n)
    (s : Clafer.Semantics.Configuration (Fin n) U) (i : Instance)
    (r : Represents v s i) (scopes : List Scope) (w : Nat)
    (h : Satisfies (target v scopes w) i) : s.Groups (interpret v.core) := by
  classical
  intro d hd p hp
  have hf := Module.fact_true _ _ h.2.2.2.2.2 _
    (List.mem_map.mpr ⟨_, group_generated v d hd, rfl⟩)
  have hu := (Formula.eval_all_true (interval_term _ _) w i [] (head v d)).mp hf
    [(r.objects p).val] (by simpa [head] using (r.heads d p).mp hp)
  have hn := (interval_eval_iff w _ _ i [(r.objects p).val]).mp hu |>.2
  rw [unary_card (s.Child (interpret v.core) d p) (fun x => (r.objects x).val)
    (Subtype.val_injective.comp r.objects.injective) _ (represented_children v s i r d p)] at hn
  exact (DPGraph.Predicates.inRange_card _ _).mpr hn

end ClaferCompiler.Correctness.Structural
